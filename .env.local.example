# Server-only API keys. Never prefix these with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Optional: defaults to George and Multilingual v2.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional Supabase configuration
# HomePath works with this entire file empty. Never copy real credentials into Git.
# Optional live AI is operator-only; ordinary public browser requests stay disabled.
ANTHROPIC_API_KEY=
# At least 32 random characters. Server/operator secret, NEVER NEXT_PUBLIC or browser code.
HOMEPATH_AI_ACCESS_TOKEN=

# Legacy optional database setup; the public guest demo does not use these for cases,
# documents, or resource loading. Setting credentials does NOT enable guest persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
